# IDE / editor
.idea/
.vscode/
*.swp

# Claude Code local overrides
.claude/settings.local.json

# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
build/
out/
.next/
.nuxt/
.svelte-kit/
.astro/
.cache/

# Environment / secrets
.env
.env.*
!.env.example

# 실값이 든 쿠버네티스 Secret. 예시 파일(10-secret.example.yaml)만 커밋한다 —
# 그 예시가 "이 이름으로 복사해 채우라"고 안내하므로, 실수 한 번이면 비밀값이 들어간다.
deploy/k8s/*secret*.yaml
!deploy/k8s/*secret*.example.yaml

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test / tooling output
coverage/
.nyc_output/
playwright-report/
test-results/
.lighthouseci/

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# 서브셋 원본 글꼴 (23MB) — npm run fonts:fetch 로 받는다. 결과물만 커밋한다.
.fontsrc/

# 개인 문서 — 전화번호·경력이 담긴 원본 자료. 책 내용의 출처지만 저장소에는 두지 않는다.
# 판형을 참고하려고 받아 둔 **남의** 이력서도 함께 막는다. 실수로 한 번 올라가면
# 그 사람의 전화번호와 경력이 공개 저장소에 남는다.
박종건*.pdf
박종훈*.pdf
이력서-*

# TypeScript 증분 빌드 캐시 — 기계마다 내용이 다르고 매번 바뀐다.
tsconfig.tsbuildinfo

# Lighthouse 실행 산출물
.lighthouseci/
.lhci-tmp/
