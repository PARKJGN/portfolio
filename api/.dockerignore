# 빌드 컨텍스트에서 뺄 것.
#
# Dockerfile 은 지금 필요한 것만 골라 COPY 하므로 이 파일이 없어도 비밀값이 이미지에
# 들어가지는 않는다. 다만 컨텍스트에는 통째로 실려 데몬까지 간다 — 느리고, 언젠가
# 누군가 `COPY . .` 한 줄을 더하는 날 .env 가 그대로 이미지에 박힌다. 그 가능성을 미리
# 없앤다.

# 비밀값
.env
.env.*
!.env.example

# 이미지 안에서 다시 만든다
node_modules
dist

# 실행에 필요 없는 것
tests
*.test.ts
vitest.config.ts
eslint.config.mjs
docker-compose.dev.yml
.dockerignore
Dockerfile
