{
  "name": "portfolio-guestbook-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "방명록 API — 정적 사이트 옆에 따로 뜨는 작은 서비스",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "migrate:prod": "node dist/db/migrate.js",
    "test": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run",
    "test:watch": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "fastify": "^5.11.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
