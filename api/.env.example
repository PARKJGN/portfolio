# 방명록 API 환경변수.
#
# 이 파일은 예시다. 실제 값은 로컬에서 `.env` 로 복사해 채우고, 운영에서는
# k8s Secret 으로 주입한다. **어떤 실제 값도 커밋하지 않는다**(헌장 기술 제약).

# ── 서버 ──
PORT=8080
NODE_ENV=development

# 브라우저에서 이 API 를 부를 수 있는 출처. 운영은 사이트 도메인 하나뿐이고,
# 로컬은 사이트(3000)와 API(8080)가 갈리므로 개발 출처를 여기에 적는다.
# 쉼표로 여러 개를 적을 수 있다. 로컬은 next dev(3000)와 정적 미리보기(4321) 둘이다.
ALLOWED_ORIGIN=http://localhost:3000,http://127.0.0.1:4321

# ── 데이터베이스 ──
# 운영: postgres.onebite.svc.cluster.local  (oneBite 인스턴스를 공유하되 계정은 분리)
# 로컬: localhost
PGHOST=localhost
PGPORT=5432
PGDATABASE=portfolio
PGUSER=portfolio
PGPASSWORD=

# ── 유해성 판정 (3층) ──
# 이 키가 없거나 호출이 실패하면 글은 공개되지 않고 보류로 간다.
# 판정 없이 통과시키지 않는다 (FR-013).
ANTHROPIC_API_KEY=
# 판정을 기다리는 한계. 넘으면 기다리지 않고 보류로 처리해 응답한다.
VERDICT_TIMEOUT_MS=4000

# ── 주인 ──
# 보류함 조회와 삭제에 쓰는 토큰. `openssl rand -hex 32` 로 만든다.
ADMIN_TOKEN=

# ── 남용 방지 ──
# 접속 식별값을 해시할 때 섞는 소금. 없으면 주소 공간이 좁아 되돌릴 수 있다.
# `openssl rand -hex 32` 로 만든다.
CLIENT_HASH_SALT=
# 같은 출처가 이 시간 안에 남길 수 있는 글 수. 데이터베이스가 세므로 재시작해도 유지된다.
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX=5
# 순간 폭주 막이 — 같은 출처가 1분에 두드릴 수 있는 횟수(목록 조회 포함). 메모리가 센다.
# E2E 는 한 주소에서 훨씬 자주 두드리므로 그때만 크게 올려 띄운다(quickstart.md 참고).
BURST_LIMIT_MAX=30
